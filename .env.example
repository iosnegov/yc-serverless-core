# ====================================================
# Yandex Cloud Authentication & Identity
#   - YC_AUTHORIZED_KEY: Path to the authorized key file (.json) for service account authentication.
#   - YC_FOLDER_ID: Unique ID of your Yandex Cloud folder (from URL in console).
#   - YC_SERVICE_ACCOUNT_ID: Unique ID of the service account used for deployments.
# ====================================================

YC_AUTHORIZED_KEY="./app/deploy/authorized_key.json"
YC_FOLDER_ID=
YC_SERVICE_ACCOUNT_ID=

# ====================================================
# S3 Connection Settings
#   - S3_ACCESS_KEY: Static access key ID for Object Storage (from service account).
#   - S3_SECRET_KEY: Static secret key for Object Storage (from service account).
#   - S3_REGION: Yandex Cloud region (e.g., ru-central1).
#   - S3_BUCKET_NAME: Name of the to-be-created S3 bucket. 
#                     Must be globally unique across all Yandex Cloud users — 
#                     bucket names share a single namespace.
# ====================================================

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION="ru-central1"
S3_BUCKET_NAME="yc-serverless-bucket-abc123"

# ====================================================
# Serverless Resources Naming
#   - LOCKBOX_SECRET_NAME: Name of the Lockbox secret.
#   - SERVERLESS_FUNCTION_NAME: Name of the Cloud Function resource in Yandex.
#   - SERVERLESS_FUNCTION_PATH: Local path to the Cloud Function source code.
# ====================================================

LOCKBOX_SECRET_NAME="yc-serverless-secret"
SERVERLESS_FUNCTION_NAME="yc-serverless-function"
SERVERLESS_FUNCTION_PATH="./app/cloud_function/"

# ====================================================
# API Gateway Configuration
#   - OPENAPI_SPEC_PATH: Path to the OpenAPI specification file for API Gateway.
#   - API_GATEWAY_NAME: Name of the API Gateway resource in Yandex Cloud.
# ====================================================

OPENAPI_SPEC_PATH="./app/deploy/openapi.yaml"
API_GATEWAY_NAME="yc-serverless-gateway"